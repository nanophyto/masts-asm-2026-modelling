# syntax=docker/dockerfile:1
# Quick source-only update from an already tested, sysimage-equipped image.
# PackageCompiler and third-party dependencies are inherited unchanged.
ARG BASE_IMAGE=masts-asm-2026-modelling:pr2
FROM ${BASE_IMAGE}

# A changed dependency specification requires a fresh scientific base image.
COPY oceanbiome/*.toml /tmp/refresh-env/
COPY abil/requirements.txt /tmp/refresh-requirements.txt
RUN cmp /tmp/refresh-env/Project.toml /opt/workshop/source/oceanbiome/Project.toml \
    && cmp /tmp/refresh-requirements.txt /opt/workshop/source/abil/requirements.txt \
    && if test -f /tmp/refresh-env/Manifest.toml; then \
         cmp /tmp/refresh-env/Manifest.toml /opt/workshop/source/oceanbiome/Manifest.toml; \
       fi

# Reuse the pinned CSV extension from the tested base image when available.
# Download it once if the base predates the editor-cleanup PR.
ARG CSV_EXTENSION_VERSION=0.1.5
RUN if ! test -s /opt/workshop/vsix/csv.vsix; then \
      curl -fL --retry 4 --retry-delay 2 \
        "https://open-vsx.org/api/devyas319/csv-interactive-table-viewer/${CSV_EXTENSION_VERSION}/file/devyas319.csv-interactive-table-viewer-${CSV_EXTENSION_VERSION}.vsix" \
        -o /opt/workshop/vsix/csv.vsix; \
    fi

# The upstream BATS regressor additionally uses Matplotlib and Seaborn.
# Keep these layers separate from Julia/PackageCompiler and changing exercises.
COPY abil/requirements-bats.txt /tmp/requirements-bats.txt
RUN /opt/workshop/python/bin/python -m pip install --no-cache-dir -r /tmp/requirements-bats.txt \
    && /opt/workshop/python/bin/python -c 'import matplotlib, seaborn; from abil.tune import ModelTuner; from abil.predict import ModelPredictor; from abil.post import AbilPostProcessor'

# Include pinned upstream BATS CSVs in the image so participants work offline.
COPY abil/fetch_bats_data.py /tmp/fetch_bats_data.py
RUN /opt/workshop/python/bin/python /tmp/fetch_bats_data.py \
      --dest /opt/workshop/source/workshop/02_Abil/data
ENV MPLBACKEND=Agg

COPY . /opt/workshop/source
# Remove the superseded mixing exercise if the base image contained it.
RUN rm -f /opt/workshop/source/workshop/01_OceanBioME/04_mixing.jl
COPY container/ensure_language_extensions.py /opt/workshop/ensure_language_extensions.py
COPY container/configure_editor.py /opt/workshop/configure_editor.py
RUN /opt/workshop/python/bin/python /opt/workshop/ensure_language_extensions.py verify /opt/workshop/vsix \
    && /opt/workshop/python/bin/python /opt/workshop/configure_editor.py remove-google-ai /opt/code-oss/extensions \
    && /opt/workshop/python/bin/python /opt/workshop/configure_editor.py remove-google-ai /opt/code-oss/resources/app/extensions
COPY container/100_seed-workshop.sh /etc/workstation-startup.d/100_seed-workshop.sh
COPY container/210_warmup_workstation.sh /etc/workstation-startup.d/210_warmup_workstation.sh
COPY container/warmup_workstation.py /opt/workshop/warmup_workstation.py
COPY container/workspace-settings.json /opt/workshop/workspace-settings.json
COPY container/machine-settings.json /opt/workshop/machine-settings.json
ENV MASTS_WARMUP_ON_START=1

RUN /opt/workshop/python/bin/python -m unittest discover -s abil/tests -p 'test_*.py' -q \
    && python -m unittest discover -s container -p 'test_*.py' -q \
    && JULIA_DEPOT_PATH=/opt/workshop/julia-depot \
       julia --threads=1 --startup-file=no --project=oceanbiome \
       -e 'using MASTSWorkshop, CairoMakie; @assert !isnothing(Base.get_extension(MASTSWorkshop, :MASTSWorkshopMakieExt)); @assert !isempty(methods(MASTSWorkshop.plot_parameter_response)); @assert !isempty(methods(MASTSWorkshop.plot_parameter_export))'
